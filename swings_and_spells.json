{
  "_meta": {
    "description": "Catalog of all swings (basic attacks) and spells available in SpellSwing.",
    "source": "server.js",
    "notes": [
      "Swings are physical attacks available to all characters. Damage scales with character level.",
      "Spells are typed magical attacks. Each character starts knowing two spells (their starter pair) and can learn more from shops/level-ups.",
      "Spell damage uses the type chart (see type_chart.json) for super effective / not very effective multipliers.",
      "Charged and Power swings combine physical damage with the character's typed magical damage."
    ]
  },

  "swings": [
    {
      "id": "basic",
      "name": "Basic Swing",
      "energyCost": 1,
      "manaCost": 0,
      "target": "single",
      "baseDamage": 12,
      "damageFormula": "12 + (level - 1) * 4 + swing flat bonuses",
      "damageType": "physical",
      "description": "Standard physical attack on one enemy. Successful swings have a 25% chance to apply Bleed."
    },
    {
      "id": "charged",
      "name": "Charged Swing",
      "energyCost": 2,
      "manaCost": 1,
      "target": "single",
      "baseDamage": 20,
      "damageFormula": "20 + (level - 1) * 5 + swing flat bonuses",
      "damageType": "split (50% physical / 50% typed magic)",
      "description": "A charged strike that mixes physical force with the wielder's elemental type. Successful swings have a 25% chance to apply Bleed."
    },
    {
      "id": "power",
      "name": "Power Swing",
      "energyCost": 3,
      "manaCost": 2,
      "target": "single",
      "baseDamage": 30,
      "damageFormula": "30 + (level - 1) * 6 + swing flat bonuses",
      "damageType": "split (40% physical / 60% typed magic)",
      "description": "A heavy elemental swing with strong type interactions. Successful swings have a 25% chance to apply Bleed."
    }
  ],

